{$KINBOARD_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	handle /api/* {
		reverse_proxy api:8787
	}
	handle /health {
		reverse_proxy api:8787
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

KINBOARD_DOMAIN=kinboard.example.com
# Required. URL-safe because it is embedded in DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# Required. openssl rand -base64 32
# Peppers the adult-PIN hash (and later encrypts calendar credentials). Changing it resets the PIN.
KINBOARD_MASTER_KEY=
# Optional initial adult PIN (4-8 digits), used only while the household has none. Adults change it in the app.
KINBOARD_PIN=

{
  "name": "@kinboard/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell that wraps the @kinboard/web build (#/app route) for iOS and Android",
  "scripts": {
    "sync": "pnpm --filter @kinboard/web build && cap sync",
    "android": "cap run android",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
